# RAG layer — copy to .env, fill locally, NEVER commit real keys.

# Vault = source of truth (your existing Obsidian 2nd Brain)
VAULT_PATH=/Users/tumeloramaphosa/Documents/Obsidian Vault/2nd Brain

# Embedder: local Ollama nomic-embed-text (768-dim, free). No cloud cost.
OLLAMA_BASE_URL=http://localhost:11434

# Vector store backend: sqlite (local default) | pinecone | memory
VECTOR_STORE=sqlite

# --- sqlite-vec (local, private, free) ---
RAG_SQLITE_PATH=rag-index.sqlite

# --- Pinecone (opt-in cloud; chunks leave your Mac) ---
# Create the index at dimension = embedder dim (768 for nomic-embed-text).
PINECONE_API_KEY=
PINECONE_INDEX_HOST=        # e.g. studex-vault-xxxx.svc.us-east-1-aws.pinecone.io
PINECONE_NAMESPACE=studex-vault

# Offline smoke only (deterministic, non-semantic) — leave unset in real use.
# RAG_FAKE=1
